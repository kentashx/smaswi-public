s=\"footer-section\">\n                    <h3>お問い合わせ</h3>\n                    <p>\n                        <a href=\"mailto:contact@smaswi.com\">contact@smaswi.com</a>\n                    </p>\n                </div>\n                <div class=\"footer-section\">\n                    <h3>法的情報</h3>\n                    <ul class=\"footer-links\">\n                        <li>\n                            <a href=\"terms_of_service.html\">利用規約</a>\n                        </li>\n                        <li>\n                            <a href=\"privacy_policy.html\">プライバシーポリシー</a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"footer-bottom\">\n                <p>&copy; 2025 SmartSwim. All rights reserved.</p>\n            </div>\n        </footer>\n        <script>\n        // Mobile menu toggle\n        function toggleMenu() {\n            const navLinks = document.getElementById('navLinks');\n            navLinks.classList.toggle('active');\n        }\n\n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const target = document.querySelector(this.getAttribute('href'));\n                if (target) {\n                    target.scrollIntoView({\n                        behavior: 'smooth',\n                        block: 'start'\n                    });\n                    // Close mobile menu if open\n                    document.getElementById('navLinks').classList.remove('active');\n                }\n            });\n        });\n\n        // Header scroll effect\n        let lastScroll = 0;\n        const header = document.querySelector('header');\n\n        window.addEventListener('scroll', () => {\n            const currentScroll = window.pageYOffset;\n            \n            if (currentScroll <= 0) {\n                header.style.boxShadow = '0 2px 20px rgba(0, 0, 0, 0.1)';\n            } else {\n                header.style.boxShadow = '0 2px 10px rgba(0, 0, 0, 0.15)';\n            }\n            \n            lastScroll = currentScroll;\n        });\n\n        // Intersection Observer for fade-in animations\n        const observerOptions = {\n            threshold: 0.1,\n            rootMargin: '0px 0px -50px 0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.style.opacity = '1';\n                    entry.target.style.transform = 'translateY(0)';\n                }\n            });\n        }, observerOptions);\n\n        // Observe all cards and features\n        document.querySelectorAll('.problem-card, .feature, .screenshot-item, .pricing-card').forEach(el => {\n            el.style.opacity = '0';\n            el.style.transform = 'translateY(30px)';\n            el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';\n            observer.observe(el);\n        });\n        </script>\n    </body>\n</html>\n"
